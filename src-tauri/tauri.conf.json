{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dither.tool",
  "version": "0.3.5",
  "identifier": "com.dither.tool",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "npm run build:assets",
    "beforeBuildCommand": "npm run build:assets"
  },
  "app": {
    "windows": [
      {
        "title": "Dither.tool",
        "url": "Bitmaptool.html",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}